# GitLab CE 镜像 tag，格式为 x.y.z-ce.0；升级时修改这一项。
GITLAB_VERSION=19.6.2-ce.0

# 仅在全新数据目录首次初始化时作为 root 初始密码。
GITLAB_ROOT_PASSWORD=replace-with-a-secure-random-password

# 可选；面向用户的完整地址，可使用域名或 http://公网IP:8929。
# GITLAB_EXTERNAL_URL=https://gitlab.example.com

# 可选；页面中 SSH Clone 地址的主机名或 IP，不含协议和端口，默认 127.0.0.1。
# GITLAB_SSH_HOST=gitlab.example.com

# 可选；Web 8929 和 Git SSH 2224 的宿主机绑定地址，默认仅本机访问。
# ECS 直接访问设为 0.0.0.0，并仅在 GitLab 实例的安全组放行所需端口。
# GITLAB_BIND_ADDR=127.0.0.1

# 可选；默认 unless-stopped。隔离恢复或由宿主机服务负责自动启动时设为 no。
# 本工程不提供宿主机服务；使用该方式须自行实现并验证 Docker / 整机重启后的自动启动。
# GITLAB_RESTART_POLICY=unless-stopped

# 可选；需要覆盖默认时区时取消注释。
# GITLAB_TIME_ZONE=Asia/Shanghai

# 可选；启用 GitLab 自带的 Container Registry 时填写面向用户的完整地址。
# HTTPS 子域名独立于主站，TLS 由前置代理终止；可信内网可用 http://内网IP:5050。
# 留空则 Registry 保持关闭。使用元数据库时须先配置备份角色，见 docs/recovery.md。
# GITLAB_REGISTRY_EXTERNAL_URL=https://registry.example.com

# 可选；Registry 发布到宿主机的端口，由前置代理转发，默认 5050。
# GITLAB_REGISTRY_PORT=5050

# 可选；Registry 端口的宿主机绑定地址，默认 127.0.0.1。
# 仅当 Runner 需要绕过代理直连推送且该地址对 Runner 容器不可达时（如 Linux 宿主机）改为内网地址。
# GITLAB_REGISTRY_BIND_ADDR=127.0.0.1

# 可选；删除需管理员共同确认（deletion control），说明见 docs/deletion-control.md。
# 取消注释 COMPOSE_PROFILES 后，日常 docker compose 命令即包含 deletion-control 服务；
# 另须把 ops/deletion-control/gitlab.rb.example 追加到持久化的 gitlab.rb 并 reconfigure。
# COMPOSE_PROFILES=deletion-control

# 删除一个工程或组需要几位管理员同意，默认 0：不管控，删除照常，和没有这个功能一样。
# 1：普通用户删除要 1 位管理员 Approve，管理员自己删除直接执行；
# 2：普通用户要 2 位，管理员发起时再要 1 位其他管理员（发起人是管理员时自动算 1 票）。
# DELETION_REQUIRED_ADMINS=0

# 存放删除申请（合并请求）的工程，填完整路径；须内部可见、有默认分支，建议建在专用账号的个人空间里。
# DELETION_REQUESTS_PROJECT=deletion-bot/deletion-requests

# 宿主机上存放 token（专用管理员账号的访问令牌，api 权限）和 upstream-key（内部入口密钥）的目录。
# 目录 0700、文件 0600，Linux 上属主为 65534:65534。ECS 建议用 /srv/gitlab/deletion-control；
# 令牌和密钥不要写进本文件。
# DELETION_SECRETS_DIR=./deletion-control
