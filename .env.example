# GitLab CE 镜像 tag，格式为 x.y.z-ce.0；升级时修改这一项。
GITLAB_VERSION=19.3.0-ce.0

# 仅在全新数据目录首次初始化时作为 root 初始密码。
GITLAB_ROOT_PASSWORD=replace-with-a-secure-random-password

# Apple Silicon 使用 linux/arm64；Intel Mac 使用 linux/amd64。
GITLAB_PLATFORM=linux/arm64

# 可选；配置反向代理时填写面向用户的完整地址。
# GITLAB_EXTERNAL_URL=https://gitlab.example.com

# 可选；需要覆盖默认时区时取消注释。
# GITLAB_TIME_ZONE=Asia/Shanghai

# 可选；启用 GitLab 自带的 Container Registry 时填写面向用户的完整地址。
# 子域名必须独立于 GitLab 主站，TLS 由前置反向代理终止。留空则 Registry 保持关闭。
# GITLAB_REGISTRY_EXTERNAL_URL=https://registry.example.com

# 可选；Registry 发布到宿主机的端口，由前置代理转发，默认 5050。
# GITLAB_REGISTRY_PORT=5050

# 可选；Registry 端口的宿主机绑定地址，默认 127.0.0.1。
# 仅当 Runner 需要绕过代理直连推送且该地址对 Runner 容器不可达时（如 Linux 宿主机）改为内网地址。
# GITLAB_REGISTRY_BIND_ADDR=127.0.0.1
